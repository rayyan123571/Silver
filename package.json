{
  "name": "silver-app",
  "private": true,
  "version": "1.0.20",
  "description": "Silver Management Desktop App",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5199 && cross-env NODE_ENV=development node scripts/run-electron.cjs .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node scripts/run-electron.cjs .",
    "obfuscate": "node scripts/obfuscate-electron.cjs",
    "dist:win": "npm run build && npm run obfuscate && electron-builder --win",
    "dist:win:unlocked": "node scripts/build-unlocked.cjs"
  },
  "build": {
    "appId": "com.chaudhrysilver.app",
    "productName": "Chaudhry Silver",
    "copyright": "Chaudhry Silver",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sql.js/dist/*.wasm"
    ],
    "extraMetadata": {
      "main": "electron-dist/main.cjs"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json",
      "!electron/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Chaudhry-Silver-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chaudhry Silver",
      "uninstallDisplayName": "Chaudhry Silver",
      "menuCategory": false
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^5.4.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
